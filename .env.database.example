# Copy to .env.database.local (ignored). Server/test tools only; never EXPO_PUBLIC.
# Use PostgreSQL direct or session-pooler connections, not transaction-pooler port 6543.
PRODUCTION_DATABASE_URL=
QA_DATABASE_URL=
# Optional Supabase CA certificate paths. TLS verification is always enabled.
PRODUCTION_DATABASE_CA_FILE=
QA_DATABASE_CA_FILE=

# Populate after registering QA's public reference in supabase/environments.json.
QA_SUPABASE_PUBLISHABLE_KEY=
QA_SUPABASE_ADMIN_KEY=
# QA backend must be configured with the QA project URL and publishable key.
QA_BACKEND_URL=http://localhost:8787
QA_BACKEND_DIR=../WinnipegBusTripPlanner-Backend

# Optional: read-only Auth configuration audit and QA-only Auth configuration updates.
SUPABASE_ACCESS_TOKEN=

# Exact data refresh only: directory containing PostgreSQL 17 pg_dump/pg_restore/psql.
# Leave empty when all three client tools are already on PATH. No local DB needed.
DATABASE_PG_BIN=
